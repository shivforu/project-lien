{
  "name": "@project-lien/worker",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@project-lien/adapters-erecording": "workspace:*",
    "@project-lien/db": "workspace:*",
    "@project-lien/domain-documents": "workspace:*",
    "@project-lien/domain-escrow": "workspace:*",
    "@project-lien/domain-fees": "workspace:*",
    "@project-lien/domain-jurisdiction": "workspace:*",
    "@project-lien/domain-pria": "workspace:*",
    "@project-lien/domain-workflow": "workspace:*",
    "@project-lien/shared-config": "workspace:*",
    "kysely": "^0.28.17"
  },
  "devDependencies": {
    "@project-lien/api": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "express": "^5.2.1",
    "pg": "^8.13.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
