# Multi-stage build for apps/web (Next.js). Built from the monorepo root context
# (`docker build -f infra/docker/Dockerfile.web .`).
FROM node:20-slim AS base
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile --filter @project-lien/web || pnpm install --filter @project-lien/web

FROM deps AS build
COPY apps/web apps/web
WORKDIR /repo/apps/web
RUN pnpm build

FROM node:20-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /repo/apps/web/.next ./.next
COPY --from=build /repo/apps/web/public ./public
COPY --from=build /repo/apps/web/package.json ./package.json
COPY --from=build /repo/apps/web/node_modules ./node_modules
EXPOSE 3000
CMD ["node_modules/.bin/next", "start"]
