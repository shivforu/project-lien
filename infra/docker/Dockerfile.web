# Multi-stage build for apps/web (Next.js). Built from the monorepo root context
# (`docker build -f infra/docker/Dockerfile.web .`).
FROM node:26-slim AS base
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile --filter @project-lien/web || pnpm install --filter @project-lien/web

FROM deps AS build
COPY apps/web apps/web
WORKDIR /repo/apps/web
RUN pnpm build

# `output: "standalone"` (apps/web/next.config.js, docs/DECISIONS.md D20) makes this stage
# possible: pnpm's default node_modules layout is symlinks pointing back up to a
# root-level `.pnpm` store, so copying `apps/web/node_modules` alone (the pre-Phase-14
# version of this file) shipped dangling symlinks with nothing on the other end — the
# image would fail at startup unable to resolve `next`/`react`. Standalone output traces
# and copies only the actually-used runtime files into a self-contained tree instead.
FROM node:26-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
# .next/standalone mirrors the monorepo path (apps/web/server.js), since this build has a
# workspace root above apps/web — matched here with WORKDIR /app so `apps/web/server.js`
# resolves the same way inside the container as it does inside .next/standalone/apps/web.
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["node", "apps/web/server.js"]
