# Copy to .env and fill in for local development.
# Nothing in this file is a real secret. See docs/EXTERNAL_DEPENDENCIES.md for what
# every vendor-shaped variable actually does locally (mock adapters) vs. in production.

# --- Core ---
NODE_ENV=development
LOG_LEVEL=info

# --- Database ---
# Host-side port 5433, not Postgres's usual 5432 (docs/DECISIONS.md D26) — 5432 is the
# single most likely port to already be taken by some *other* project's Postgres on a dev
# machine, and a stopped-but-still-port-reserved container can make that collision look
# like a credentials problem instead of a port conflict.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/project_lien

# --- API ---
API_PORT=4000
JWT_ACCESS_SECRET=dev-only-change-me-access
JWT_REFRESH_SECRET=dev-only-change-me-refresh
# These were unused placeholders through Phase 12 (the TTLs were hardcoded in
# apps/api/src/auth/jwt.ts); actually wired to config in Phase 13 — see docs/DECISIONS.md
# D19. Default refresh TTL corrected to 7d to match the actual implementation.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Object storage (MinIO locally / S3+KMS in production — see docs/DEPLOYMENT.md) ---
STORAGE_DRIVER=minio        # minio | s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=project-lien-documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# --- Worker / job queue ---
WORKER_POLL_INTERVAL_MS=5000
WORKER_JOB_CLAIM_TIMEOUT_MS=120000
WORKER_MAX_ATTEMPTS=5

# --- eRecording vendor adapters (MOCK ONLY — no real credentials exist, see
#     docs/EXTERNAL_DEPENDENCIES.md). Left here so the config shape is ready for the
#     day real credentials are supplied. ---
SIMPLIFILE_MODE=mock
SIMPLIFILE_BASE_URL=
SIMPLIFILE_API_KEY=
CSC_MODE=mock
CSC_SOAP_URL=
CSC_ACCOUNT_ID=
EPN_MODE=mock
EPN_BASE_URL=
EPN_API_KEY=

# --- Webhooks ---
WEBHOOK_SIGNING_SECRET=dev-only-change-me-webhook

# --- CORS (Phase 13) ---
# Comma-separated allowlist of origins the API accepts. "*" (below) is dev-only and
# reflects any origin; a deployed environment should set this to its real web app
# origin(s), e.g. CORS_ORIGIN=https://app.example.com — see docs/DECISIONS.md D19.
CORS_ORIGIN=*

# --- Rate limiting (Phase 13; docs/DECISIONS.md D19) ---
# A tighter window on /auth/login specifically (credential-stuffing/brute-force
# mitigation), plus a looser general limit across the rest of the versioned API surface.
# These replace this file's earlier RATE_LIMIT_WINDOW_MS/RATE_LIMIT_MAX placeholders,
# which never corresponded to an actual implementation until this phase.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MS=60000
