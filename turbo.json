{
  "$schema": "https://turbo.build/schema.json",
  // Every package's tsconfig.json does `"extends": "../../tsconfig.base.json"`, but turbo's
  // default input-hashing for a task only looks at files inside that task's own package
  // directory (plus the lockfile and any declared env vars) — it has no way to know a task
  // depends on a file two directories up unless told so explicitly here. Without this,
  // editing tsconfig.base.json (e.g. docs/DECISIONS.md D28's removal of "composite") is
  // invisible to turbo's cache: every package's build task keeps whatever it last cached,
  // even though what `tsc` would now actually produce has changed — confirmed directly by
  // editing tsconfig.base.json and re-running `pnpm build` without this: still "FULL TURBO",
  // 15/15 cached, 78ms, correctly re-running nothing. This is what let a real user's
  // already-broken cached dist/ output (produced during the still-buggy D28 state, missing
  // its .d.ts) keep being silently replayed even after they pulled the D28 fix itself.
  "globalDependencies": ["tsconfig.base.json"],
  "globalPassThroughEnv": [
    "PLAYWRIGHT_BROWSERS_PATH",
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "PATH",
    "HOME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      // `api`/`worker` import several internal workspace packages (@project-lien/db,
      // shared-config, the domain-* packages, ...) via their compiled "main": "dist/..."
      // entry point, not their TS source — tsx/node module resolution can't see through
      // that to packages/*/src. Without this, `pnpm dev` on a genuinely fresh clone (or
      // after `pnpm clean`) crashes both api and worker on boot with `MODULE_NOT_FOUND`
      // for any such package whose dist/ doesn't exist yet, while web (which doesn't
      // import them directly — it only talks to the API over HTTP) starts up fine and
      // masks the failure (docs/DECISIONS.md D27). `^build` only builds this package's
      // dependencies, not the package's own dev-mode app, so this doesn't fight tsx
      // watch's/next dev's own live-reload of api/web/worker's own source.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["build"]
    },
    "clean": {
      "cache": false
    }
  }
}
